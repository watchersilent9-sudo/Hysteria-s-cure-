const $ = id => document.getElementById(id);
const formatNumber = value => Number(value || 0).toLocaleString();

function toast(message) {
  $("toast").textContent = message;
  $("toast").classList.add("show");
  clearTimeout(toast.timer);
  toast.timer = setTimeout(() => {
    $("toast").classList.remove("show");
  }, 3500);
}

function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, character => ({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[character]);
}

function getUserFaction() {
  const value =
    state.profile.faction ??
    state.profile.profile?.faction ??
    state.profile.account?.faction ??
    "independent";

  return Object.hasOwn(factionLabels, value) ? value : "independent";
}

function filteredRewards() {
  return rewards.filter(reward => {
    const factionMatches =
      state.faction === "all" ||
      reward.f.includes(state.faction);

    const categoryMatches =
      state.category === "all" ||
      reward.cat === state.category;

    const availabilityMatches =
      state.availability === "all" ||
      reward.status === state.availability;

    const searchText = [
      reward.name,
      reward.desc,
      reward.tags,
      categoryNames[reward.cat]
    ].join(" ").toLowerCase();

    const searchMatches =
      !state.search || searchText.includes(state.search);

    return factionMatches && categoryMatches &&
      availabilityMatches && searchMatches;
  });
}

