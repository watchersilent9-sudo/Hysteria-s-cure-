      </div>

      <h3>${escapeHTML(reward.name)}</h3>
      <p class="desc">${escapeHTML(reward.desc)}</p>

      <div class="cat">
        ${escapeHTML(categoryNames[reward.cat])}
        · ${available ? "Internal reward" : "External / planned reward"}
      </div>

      <div class="cardfoot">
        <div class="cost">
          ${formatNumber(reward.cost)} pts
          <small>Catalogue cost</small>
        </div>
        <button type="button"
          data-reward-id="${escapeHTML(reward.id)}"
          ${available && state.uid ? "" : "disabled"}>
          ${buttonText}
        </button>
      </div>
    </article>
  `;
}

function render() {
  const list = filteredRewards();
  $("count").textContent =
    `${list.length} reward${list.length === 1 ? "" : "s"}`;

  if (!list.length) {
    $("catalogueOutput").innerHTML =
      '<div class="empty">No rewards match. Try another search or filter.</div>';
    return;
  }

  const groups = state.faction === "all"
    ? ["readers","gamers","movie-lovers","shared"]
    : [state.faction];

  $("catalogueOutput").innerHTML = groups.map(faction => {
    const items = list.filter(reward => reward.f.includes(faction));
    if (!items.length) return "";

    const info = factionMeta[faction];

    return `
      <section>
        <div class="strip">
          <div class="icon">${info[0]}</div>
          <div><h3>${info[1]}</h3><p>${info[2]}</p></div>
          <div class="spacer"></div>
          <span class="count">${items.length} items</span>
        </div>
        <div class="grid">${items.map(renderCard).join("")}</div>
      </section>
    `;
  }).join("");
}

function renderHistory(rows) {
  if (!rows.length) {
    $("historyOutput").textContent = "No redemption requests yet.";
    return;
  }

  rows.sort((a, b) => Number(b.createdAt || 0) - Number(a.createdAt || 0));

  $("historyOutput").innerHTML = rows.map(request => {
    const name = escapeHTML(request.rewardName || "Reward request");
    const date = new Date(Number(request.createdAt || Date.now())).toLocaleString();
    const cost = formatNumber(request.pointsCost);
    const status = escapeHTML(request.status || "pending");

    return `
      <div class="historyrow">
        <div>
          <strong>${name}</strong>
          <p>${escapeHTML(date)} · ${cost} points</p>
        </div>
        <span>${status}</span>
      </div>
    `;
  }).join("");
}

async function loadHistory(uid) {
  try {
    const snapshot = await get(ref(database, `rewardRequests/${uid}`));
    const value = snapshot.val() || {};
    const rows = Object.values(value).filter(
      item => item && typeof item === "object"
    );
    renderHistory(rows);
  } catch (error) {
    console.error("Could not load redemption history:", error);
    $("historyOutput").textContent =
      "History unavailable. Check Firebase Realtime Database rules.";
  }
}

let redemptionInProgress = false;

async function requestReward(rewardId, button) {
  if (!state.uid || !auth.currentUser) {
    toast("Please sign in before requesting a reward.");
    return;
  }

  if (redemptionInProgress) return;

  const reward = rewards.find(item => item.id === rewardId);

  if (!reward || !internalIds.has(reward.id)) {
    toast("This reward is not currently available.");
    return;
  }

  const user = auth.currentUser;

  if (user.uid !== state.uid) {
    toast("Your session changed. Please sign in again.");
    return;
  }

  const confirmed = window.confirm(
    `Request ${reward.name} for ${formatNumber(reward.cost)} points?\n\n` +
    "This creates a pending request. It does not deduct points or grant the reward."
  );

  if (!confirmed) return;

  redemptionInProgress = true;

  if (button) {
    button.disabled = true;
    button.textContent = "Submitting…";
  }

  try {
    const accountSnapshot = await get(ref(database, `users/${user.uid}`));

    if (!accountSnapshot.exists()) {
      throw new Error("Your account record could not be found.");
    }

    const account = accountSnapshot.val() || {};
    const progress = account.progress || account.account?.progress || {};
    const points = Number(progress.points ?? account.points ?? 0);

    if (!Number.isFinite(points) || points < 0) {
      throw new Error("Your points balance is invalid.");
    }

    if (points < reward.cost) {
      throw new Error(
        `You need ${formatNumber(reward.cost)} points, but have ${formatNumber(points)}.`
      );
    }

    const requestRef = push(ref(database, `rewardRequests/${user.uid}`));

    await set(requestRef, {
      requestId:requestRef.key,
      uid:user.uid,
      rewardId:reward.id,
      rewardName:reward.name,
      rewardType:"internal",
      pointsCost:reward.cost,
      status:"pending",
      createdAt:Date.now()
    });

    toast("Your request has been submitted for review.");
    await loadHistory(user.uid);

  } catch (error) {
    console.error("Reward request failed:", error);
    toast(error.message || "Unable to submit your request.");
  } finally {
    redemptionInProgress = false;
    render();
  }
}

$("catalogueOutput").addEventListener("click", event => {
  const button = event.target.closest("[data-reward-id]");
  if (!button || button.disabled) return;
  requestReward(button.dataset.rewardId, button);
});

document.querySelectorAll(".tab").forEach(button => {
  button.addEventListener("click", () => {
    document.querySelectorAll(".tab").forEach(tab => tab.classList.remove("active"));
    button.classList.add("active");
    state.faction = button.dataset.faction;
    render();
  });
});

$("search").addEventListener("input", event => {
  state.search = event.target.value.trim().toLowerCase();
  render();
});

$("category").addEventListener("change", event => {
  state.category = event.target.value;
  render();
});

$("availability").addEventListener("change", event => {
  state.availability = event.target.value;
  render();
});

onAuthStateChanged(auth, async user => {
  state.uid = user?.uid || null;

  if (!user) {
    state.profile = {};
    $("points").textContent = "Sign in";
    $("lifetime").textContent = "—";
    $("faction").textContent = "Independent";
    $("accountStatus").textContent =
      "Browsing as a guest. Sign in to view your balance and requests.";
    $("historyOutput").textContent = "Sign in to view redemption history.";
    render();
    return;
  }

  $("accountStatus").textContent = "Loading your account…";

  try {
    const snapshot = await get(ref(database, `users/${user.uid}`));
    state.profile = snapshot.val() || {};

    const progress = state.profile.progress ||
      state.profile.account?.progress || {};

    const points = progress.points ?? state.profile.points ?? 0;
    const lifetime = progress.lifetimePoints ??
      progress.totalPointsEarned ?? "—";

    $("points").textContent = formatNumber(points);
    $("lifetime").textContent =
      lifetime === "—" ? "Not recorded" : formatNumber(lifetime);

    const faction = getUserFaction();
    $("faction").textContent = factionLabels[faction] || "Independent";

    $("accountStatus").textContent =
      `Signed in as ${user.displayName || user.email || "student"}.`;

    await loadHistory(user.uid);
  } catch (error) {
    console.error("Account data could not be loaded:", error);
    $("accountStatus").textContent =
      "Signed in, but account data could not be loaded. Check Firebase Database rules.";
  }

  render();
});

render();
</script>
</body>
</html>
