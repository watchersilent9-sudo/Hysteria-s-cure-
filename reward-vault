.status{color:var(--muted);font-size:.85rem;margin-top:13px}
.notice{margin:18px 0 26px;padding:13px 15px;border-radius:13px;border:1px solid #ffcf7844;background:#ffcf780d;color:#f7dfb2;font-size:.9rem;line-height:1.55}
